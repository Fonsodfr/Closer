<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Closer by Rave Factory</title>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>

    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="vst3" title="Closer VST3"
            description="For Ableton Live, Reaper, FL Studio, Cubase, Bitwig...">
        <pkg-ref id="com.ravefactory.closer.vst3"/>
    </choice>
    <choice id="au" title="Closer Audio Unit"
            description="For Logic Pro and GarageBand.">
        <pkg-ref id="com.ravefactory.closer.au"/>
    </choice>

    <pkg-ref id="com.ravefactory.closer.vst3">Closer-VST3.pkg</pkg-ref>
    <pkg-ref id="com.ravefactory.closer.au">Closer-AU.pkg</pkg-ref>
</installer-gui-script>
